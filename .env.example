# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used solely by /api/invite to send the partner invitation email. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# The deployed URL, e.g. https://our-little-universe.vercel.app (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. Without a token the map uses free CARTO/OpenStreetMap tiles.
# Mapbox tokens are loaded in the browser, so use a public (pk.) token restricted to your domain.
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=
